{
  "name": "vokter",
  "version": "1.0.0",
  "private": true,
  "description": "Vokter is a full-stack e-commerce platform for urban tech, accessories and home goods, built around three differentiators: verified product authenticity, an AI shopping assistant grounded in the real catalog, and a drop system with waitlists.",
  "homepage": "https://github.com/Cachureto/NOVA#readme",
  "bugs": {
    "url": "https://github.com/Cachureto/NOVA/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cachureto/NOVA.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run android -w apps/mobile",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:seed": "npm run db:seed -w apps/backend",
    "db:admin": "npm run db:admin -w apps/backend --"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "npm@11.6.1",
  "overrides": {
  "react": "19.2.3",
  "react-dom": "19.2.3"
  }
}
