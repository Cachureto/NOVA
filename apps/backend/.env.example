# ---- Servidor ----
NODE_ENV=development
PORT=4000
# Orígenes permitidos por CORS, separados por coma (la web de Next.js).
# En producción, con el proxy /api de Next, la web llama al backend desde el
# servidor y no manda Origin, así que esto solo importa si algún cliente
# externo llama a la API directamente desde un navegador.
CORS_ORIGINS=http://localhost:3000

# ---- Base de datos ----
# Puerto 5433, que es el que expone docker-compose.yml para no chocar con una
# instalación de PostgreSQL que ya tengas en el 5432.
#
# En producción (Neon, Supabase…) usa la cadena "pooled" del proveedor, la que
# lleva -pooler en el host: en serverless cada instancia abre su propia
# conexión y el pooling tiene que hacerlo la base, no el proceso.
DATABASE_URL=postgres://nova:nova_dev@localhost:5433/nova

# ---- JWT ----
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-por-una-cadena-aleatoria-de-32-o-mas-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- IA (buscador conversacional) ----
# Clave gratuita en https://aistudio.google.com/apikey
# Si la dejas vacía, todo lo demás funciona; solo el asistente queda deshabilitado.
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
