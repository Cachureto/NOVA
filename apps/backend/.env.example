# ---- Servidor ----
NODE_ENV=development
PORT=4000
# Orígenes permitidos para CORS (web), separados por coma
CORS_ORIGINS=http://localhost:3000

# ---- Base de datos ----
# Docker:            postgres://nova:nova_dev@localhost:5432/nova
# Postgres instalado: postgres://postgres:nova_dev@localhost:5432/nova
DATABASE_URL=postgres://nova:nova_dev@localhost:5432/nova

# ---- JWT ----
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- IA (se usa en pasos siguientes) ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=