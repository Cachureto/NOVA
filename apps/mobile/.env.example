# URL del backend de Vokter.
#
# En desarrollo (expo start) déjalo vacío: la app detecta sola la IP del PC
# desde el que Expo sirve el bundle, así funciona igual en emulador y en
# teléfono físico.
#
# En el APK de EAS NO hay servidor de Expo, así que la URL se hornea en el
# build: se define en eas.json (perfiles preview y production), no aquí.
EXPO_PUBLIC_API_URL=

# Origen que sirve las fotos del catálogo (la web de Next.js). Si se deja
# vacío, se usa el mismo host que la API con el puerto 3000.
EXPO_PUBLIC_WEB_URL=
