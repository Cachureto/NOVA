# ---- API ----
# En local, la URL del backend: el navegador va directo a ella.
#
# En producción déjala VACÍA. Así el navegador usa rutas relativas (/api/...)
# y Next las reenvía al backend con el rewrite de next.config.mjs, que es lo
# que mantiene la cookie del refresh token en el mismo dominio.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Origen del backend al que apunta ese rewrite y que usan los Server
# Components. En local no hace falta; en Vercel es la URL del proyecto de la API.
# API_ORIGIN=https://vokter-api.vercel.app

# Enlace directo al APK de la app móvil (EAS Build). Si está vacío, /download
# muestra "en construcción".
NEXT_PUBLIC_APK_URL=

# URL pública de esta web. La usa el QR de /download mientras no haya APK.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
